# Copy this file to .env and fill in your API keys
# cp .env.example .env

# Required: Google API key for Gemini
GOOGLE_API_KEY=your-google-api-key-here

# Optional: LangSmith API key for tracing/debugging
# LANGSMITH_API_KEY=your-langsmith-api-key-here

# Optional: Web of Science API credentials (OAuth 2.0 Client Credentials)
# Get your credentials from: https://developer.clarivate.com/
# WOS_CLIENT_ID=your-wos-client-id-here
# WOS_CLIENT_SECRET=your-wos-client-secret-here

# Optional: SerpAPI key for Google Scholar searches
# Get your API key from: https://serpapi.com/
# Free tier: 100 searches/month
# SERPAPI_KEY=your-serpapi-key-here
